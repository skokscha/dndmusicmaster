    <!-- Onboarding (stage 3) -->
    <string name="onboarding_title">Welcome to DnDSound</string>
    <string name="onboarding_body">Point the app at a folder with your music and sounds. It reads only the files you pick and works fully offline — it has no INTERNET permission at all.\n\nExpected layout: music/&lt;mood&gt;, ambience/&lt;environment&gt;, sounds/&lt;category&gt;, weather/&lt;type&gt;. See docs/CONTENT.md for details.</string>
    <string name="onboarding_pick_folder">Pick library folder</string>
    <string name="onboarding_create_hint">You can pick an empty folder — the “Create structure” button will make the subfolders for you.</string>

